{
  "$schema": "../../schemas/module.schema.json",
  "sdk": 1,
  "id": "dev.sshkipper.example.processes",
  "version": "1.0.0",
  "title": { "ru": "Процессы", "en": "Processes" },
  "description": { "ru": "Нагрузка, память и самые занятые процессы сервера; остановить или перезапустить процесс сигналом.",
                   "en": "Load, memory and the busiest processes of a server; stop or reload a process with a signal." },
  "author": { "name": "SSHKipper", "url": "https://github.com/kdanet/sshkipper-sdk" },
  "license": "MIT",
  "icon": { "symbol": "cpu", "color": "indigo" },
  "runtime": { "kind": "server" },
  "permissions": ["exec", "sudo"],
  "settings": [
    { "key": "limit", "title": { "ru": "Сколько процессов показывать", "en": "Processes to show" }, "type": "number", "default": 40 },
    { "key": "busy", "title": { "ru": "«Занят», если CPU больше, %", "en": "«Busy» above CPU, %" }, "type": "number", "default": 80 }
  ],
  "service": {
    "detect": "detect",
    "summary": "summary",
    "page": "main",
    "containers": true
  },
  "pages": [
    { "id": "main", "title": { "ru": "Процессы", "en": "Processes" }, "view": "views/main.json",
      "data": { "overview": "overview", "procs": "list" }, "refresh": 5 },
    { "id": "process", "title": { "ru": "Процесс", "en": "Process" }, "view": "views/process.json",
      "data": { "proc": "details" }, "refresh": 5 }
  ],
  "handlers": {
    "detect": { "script": "scripts/detect.sh", "timeout": 10, "sudo": "never" },
    "summary": { "script": "scripts/summary.sh", "timeout": 10 },
    "overview": { "script": "scripts/overview.sh", "timeout": 10, "sudo": "never" },
    "list": { "script": "scripts/list.sh", "timeout": 15 },
    "details": { "script": "scripts/details.sh", "timeout": 10 },
    "signal_term": { "script": "scripts/signal.sh", "timeout": 10 },
    "signal_hup": { "script": "scripts/signal.sh", "timeout": 10 },
    "signal_kill": { "script": "scripts/signal.sh", "timeout": 10 }
  },
  "actions": [
    { "id": "stop", "title": { "ru": "Остановить (TERM)", "en": "Stop (TERM)" }, "symbol": "stop.circle.fill", "handler": "signal_term",
      "risk": "change", "on": "item", "confirm": { "ru": "Остановить процесс {{ item.name }} ({{ item.pid }})?", "en": "Stop {{ item.name }} ({{ item.pid }})?" } },
    { "id": "reload", "title": { "ru": "Перечитать настройки (HUP)", "en": "Reload (HUP)" }, "symbol": "arrow.clockwise", "handler": "signal_hup",
      "risk": "change", "on": "item", "confirm": { "ru": "Послать HUP процессу {{ item.name }} ({{ item.pid }})?", "en": "Send HUP to {{ item.name }} ({{ item.pid }})?" } },
    { "id": "kill", "title": { "ru": "Убить (KILL)", "en": "Kill (KILL)" }, "symbol": "xmark.octagon.fill", "handler": "signal_kill",
      "risk": "danger", "on": "item", "confirm": { "ru": "Убить {{ item.name }} ({{ item.pid }}) без шанса завершиться?", "en": "Kill {{ item.name }} ({{ item.pid }}) without a chance to exit?" } }
  ],
  "tools": [
    { "name": "top", "title": { "ru": "Самые занятые процессы", "en": "Busiest processes" }, "description": "The busiest processes of the server by CPU: pid, user, CPU %, memory, uptime and command line.",
      "handler": "list", "risk": "read" },
    { "name": "stop", "title": { "ru": "Остановить процесс (TERM)", "en": "Stop a process (TERM)" }, "description": "Stops a process of the server with SIGTERM (it may finish its work first). A change: asked about in the strict mode and on Production.", "handler": "signal_term", "risk": "change",
      "params": [ { "key": "pid", "title": "PID", "type": "number", "required": true } ] }
  ],
  "automation": [
    { "id": "top", "title": { "ru": "Самые занятые процессы", "en": "Busiest processes" }, "symbol": "cpu",
      "handler": "list", "risk": "read", "returns": "json" }
  ],
  "components": {
    "kpi": { "type": "metric", "title": "{{ props.title }}", "value": "{{ props.value }}", "unit": "{{ props.unit | default:'' }}",
             "status": "{{ props.status | default:'' }}" }
  }
}
